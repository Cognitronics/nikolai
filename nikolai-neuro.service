[Unit]
Description=NikolAI – neural agent learning language from scratch (Cognitronics)
After=network.target

[Service]
User=georg
WorkingDirectory=/home/georg/nikolai/neuro11
ExecStart=/home/georg/nikolai/neuro-venv/bin/python -m neuro --web 8091 --host 0.0.0.0 --speicher /home/georg/nikolai/neuro/gehirn.pt --threads 6 --leser /home/georg/nikolai/neuro/leser_babylm.pt --buch /home/georg/nikolai/buecher/babylm
Restart=always
Nice=10

[Install]
WantedBy=multi-user.target
