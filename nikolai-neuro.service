[Unit]
Description=NikolAI – neural agent learning language from scratch (Cognitronics)
After=network.target

[Service]
User=georg
WorkingDirectory=/home/georg/nikolai/nikolai
ExecStart=/home/georg/nikolai/neuro-venv/bin/python -m neuro --web 8091 --host 0.0.0.0 --save /home/georg/nikolai/neuro/brain.pt --threads 6 --reader /home/georg/nikolai/neuro/reader_babylm.pt --book /home/georg/nikolai/books/babylm
Restart=always
Nice=10

[Install]
WantedBy=multi-user.target
